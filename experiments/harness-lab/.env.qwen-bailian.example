# 百炼 Qwen 对照专用；复制为 .env.qwen-bailian.local 后只填写 Key。
# .local 文件不提交 Git，不用于直接切换线上服务。
LLM_API_KEY=
LLM_PROVIDER=aliyun-bailian
LLM_MODEL=qwen3.8-max-0902
LLM_BASE_URL=https://ws-9o7uja66sj6pvrf9.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_CONTEXT_WINDOW=1000000
# 本轮请求输出上限；不是模型最大能力或整轮预算。
LLM_MAX_OUTPUT_TOKENS=32768
AGENT_RUN_TIMEOUT_MS=0
LLM_HTTP_IDLE_TIMEOUT_MS=300000
# 推理配置由待验证的适配显式发送：enable_thinking=true、reasoning_effort=xhigh。
# 不同时设置 thinking_budget；多轮 reasoning_content 须原字段回传。
# 当前文件本身不会启用推理，填写 Key 后先做离线适配检查和冒烟。
