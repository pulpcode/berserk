{
  "name": "@berserk/harness-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "tsx watch --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "probe:live": "tsx --env-file-if-exists=.env.local scripts/probe-live.ts",
    "probe:workspace": "tsx --env-file-if-exists=.env.local scripts/probe-workspace.ts",
    "migrate:workspace": "tsx scripts/migrate-workspace.ts",
    "probe:compaction": "tsx --env-file-if-exists=.env.local scripts/probe-compaction.ts",
    "probe:subagent": "tsx --env-file-if-exists=.env.local scripts/probe-subagent.ts",
    "migrate:seats": "tsx --env-file=.env.local scripts/migrate-seats.ts",
    "probe:execution": "tsx scripts/probe-execution.ts",
    "probe:files": "tsx --env-file=.env.local scripts/probe-files.ts",
    "probe:files-continuation": "tsx --env-file=.env.local scripts/probe-files-continuation.ts",
    "probe:hitl": "tsx --env-file-if-exists=.env.local scripts/probe-hitl.ts",
    "probe:handoff": "tsx --env-file-if-exists=.env.local scripts/probe-handoff.ts",
    "probe:references": "tsx --env-file-if-exists=.env.local scripts/probe-references.ts",
    "access:admin": "tsx scripts/access-admin.ts",
    "probe:access": "tsx --env-file-if-exists=.env.local scripts/probe-access.ts",
    "background:admin": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local scripts/background-admin.ts",
    "probe:background": "tsx --env-file-if-exists=.env.local scripts/probe-background.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/session": "11.1.3",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.5",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
