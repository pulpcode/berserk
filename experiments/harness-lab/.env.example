# Copy to .env.local. This file is a template; never put credentials here.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Each user request: 90 seconds, up to 4 tool calls, 2048 output tokens per model call.
REQUEST_TIMEOUT_MS=90000
MAX_TOOL_CALLS=4
MAX_OUTPUT_TOKENS=2048
# Real model probes run only when explicitly invoked.
