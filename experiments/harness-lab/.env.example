LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# 默认使用经过核对的 DeepSeek Flash 容量；其他模型请在网页填写真实能力。
# LLM_CONTEXT_WINDOW=1000000
# LLM_MAX_OUTPUT_TOKENS=393216

# 单次模型流连续无进展的时限；0 表示关闭空闲计时。
LLM_HTTP_IDLE_TIMEOUT_MS=300000
# 可选单次模型调用时限；留空（不设置）时使用 SDK 默认。
# LLM_REQUEST_TIMEOUT_MS=300000
# 整轮任务默认不限时，也不限制累计工具／模型调用次数。
AGENT_RUN_TIMEOUT_MS=0
# LAB_DATA_DIR=.local

# 文件执行：应用与 Docker 同机运行，默认不提供执行网络。
LAB_SEAT_ID=test-seat
LAB_EXECUTION_ENABLED=true
LAB_EXECUTION_IMAGE=berserk-file-runtime:w01-5
# LAB_EXECUTION_CPUS=2
# LAB_EXECUTION_MEMORY_MB=1024
# LAB_EXECUTION_PIDS=128
# LAB_MAX_FILE_BYTES=104857600
# LAB_MAX_ATTACHMENTS=20

# 仅开发验证：启用通用操作确认演示工具；不影响常规 AskUser 和 bash 规则。
# LAB_HITL_DEMO_ENABLED=false
