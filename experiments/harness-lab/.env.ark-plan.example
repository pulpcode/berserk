# 火山方舟 Agent Plan；仅本 worktree 使用，不改变线上服务。
# 在下面填 Agent Plan 专属 API Key；不要填 Coding Plan 或普通后付费 Key。
LLM_API_KEY=
LLM_PROVIDER=volcengine-agent-plan
LLM_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# 方舟官方 Pi 示例中的模型容量；不是整轮测评预算。
LLM_CONTEXT_WINDOW=1048576
LLM_MAX_OUTPUT_TOKENS=393216
AGENT_RUN_TIMEOUT_MS=0
LLM_HTTP_IDLE_TIMEOUT_MS=300000
# 未启动服务或评测；正式登录配置保持由原有机制另行提供。
