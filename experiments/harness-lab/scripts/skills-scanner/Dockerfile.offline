# Linux CPython 3.12 wheels downloaded from PyPI at the pinned toolchain versions.
# Verify the supplied site-packages archive digest before building.
FROM berserk-file-runtime:w01-5
USER root
COPY site-packages/ /opt/scanner/
COPY semgrep pysemgrep /usr/local/bin/
RUN chmod 0555 /usr/local/bin/semgrep /usr/local/bin/pysemgrep && mkdir -p /input /rules
ENV PYTHONPATH=/opt/scanner HOME=/tmp LANG=C.UTF-8 SEMGREP_SEND_METRICS=off SEMGREP_ENABLE_VERSION_CHECK=0
WORKDIR /input
USER 1000:1000
