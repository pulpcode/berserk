 import type { AnnotationReadInput } from '../contracts/annotations.js';
 import { ANNOTATION_MODEL_FORMAT, extractAnnotationResult, projectAnnotationResult } from '../contracts/annotation-results.js';
 const object = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
+// Describe the accepted execution parameters, never the intended scope in user prose.
+export function describeAnnotationRead(actual: unknown, query: Partial<AnnotationReadInput>): string | undefined {
+  if (!object(actual) || !object(actual.objects)) return undefined;
+  const page = actual.objects;
+  if (!Array.isArray(page.items) || typeof page.hasMore !== 'boolean'
+    || ![page.total, page.offset, page.limit].every(value => typeof value === 'number' && Number.isSafeInteger(value) && value >= 0)
+    || (page.limit as number) < 1) return undefined;
+  const fields = query.fields ?? [];
+  if (fields.length > 6 || fields.some(field => !['geometry', 'note', 'attributes', 'style', 'sourceRefs', 'originFeatureRef'].includes(field))) return undefined;
+  const layers = query.layerIds === undefined ? '未限制' : `${query.layerIds.length} 个 ID（见 query.layerIds）`;
+  const objects = query.objectIds === undefined ? '未限制' : `${query.objectIds.length} 个 ID（见 query.objectIds）`;
+  const intersection = query.layerIds !== undefined && query.objectIds !== undefined ? '；取交集' : '';
+  return `图层筛选：${layers}；对象筛选：${objects}${intersection}。\n`
+    + `字段投影：基础摘要${fields.length ? ` + ${fields.join('、')}` : ''}。\n`
+    + `本次筛选匹配对象数：${page.total}；本页 offset=${page.offset}、limit=${page.limit}、返回=${page.items.length}、hasMore=${page.hasMore}。`;
+}
 export function annotationToolResult(actual: unknown, toolName: string, query?: Partial<AnnotationReadInput> & {mode?: string}) {
-  const data = projectAnnotationResult(actual);
+  let data = projectAnnotationResult(actual);
   if (object(data) && object(data.objects) && (query?.mode === 'read' || query?.mode === 'draft')) {
     data.query = Object.fromEntries(['objectIds','layerIds','fields'].filter(key => query[key as keyof typeof query] !== undefined).map(key => [key, structuredClone(query[key as keyof typeof query])]));
+    const readSummary = toolName === 'annotation_read' ? describeAnnotationRead(data, query) : undefined;
+    if (readSummary !== undefined) data = {readSummary, ...data};
   }
   const replayed = object(actual) && actual.replayed === true;
   const annotationResult = extractAnnotationResult({annotationResult:{schemaVersion:1,origin:toolName === 'annotation_read' ? 'receipt_read' : replayed ? 'replay' : 'write',receipt:actual}}, toolName);
